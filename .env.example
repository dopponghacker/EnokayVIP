ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Resend Email Service
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# RushPay (get keys from https://rushpay.cash -> Developers)
RUSHPAY_API_KEY=your-rushpay-api-key
RUSHPAY_WEBHOOK_SECRET=your-rushpay-webhook-secret

# Public URL of this site (used for the RushPay webhook callback)
NEXT_PUBLIC_SITE_URL=https://enokayvvip.com
