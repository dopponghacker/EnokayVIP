ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Resend Email Service
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Paystack (get keys from https://dashboard.paystack.com -> Settings -> API Keys)
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_WEBHOOK_SECRET=your-paystack-secret-key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key

# Optional: public site URL used for Paystack's return redirect.
# Only needed if the request origin does not match your public domain.
NEXT_PUBLIC_SITE_URL=https://enokayvvip.com
